# ----------------------------------------------------------------------------
# PROJECT SETTINGS
# ----------------------------------------------------------------------------
PHP_VERSION=8.3

# ----------------------------------------------------------------------------
# PORTS ON THE HOST (change these to run several projects at the same time)
# ----------------------------------------------------------------------------
WEB_PORT=8080
ADMINER_PORT=8081
DB_PORT=3306
VARNISH_PORT=8088

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------------------------------
DB_NAME=redresshub
DB_USER=user
DB_PASSWORD=admin123 # change this before deployment
DB_ROOT_PASSWORD=root_password # change this before deployment
DB_HOST=db

# ----------------------------------------------------------------------------
# DRUPAL CONFIGURATION
# ----------------------------------------------------------------------------
DRUPAL_SITE_NAME="RedressHub"
DRUPAL_HASH_SALT="change_this_to_random_string_for_security"
# comma separated list of host names Drupal accepts
DOMAIN="localhost,127.0.0.1"

# send "X-Robots-Tag: noindex" so search engines skip this site;
# set to false (or leave out) only in production
ROBOTS_NOINDEX=true

# change these before deployment
DRUPAL_ADMIN_USER=admin
DRUPAL_ADMIN_PW=admin

# load web/sites/default/settings.dev.php: Twig debugging, no render/page
# caches, no CSS/JS aggregation (never enable this in production)
DRUPAL_DEV_SETTINGS=true

# startup configuration
# The site is installed automatically when the database is empty. Set this to
# true to wipe the database and reinstall on the next container start.
DRUPAL_FORCE_REINSTALL=false
# Run `drush deploy` (updatedb + config:import + deploy hooks) on startup.
# Only enable this once config/sync contains a full config export.
DRUPAL_RUN_CONFIG_IMPORT=false
DRUPAL_RUN_COMPOSER=true
# Installation profile: 'standard' (default) gives you default content types and views,
# 'minimal' gives you a bare-bones installation
DRUPAL_INSTALL_PROFILE=standard
# Modules enabled on a fresh install (ignored when installing from config/sync)
DRUPAL_MODULES="memcache search_api devel admin_toolbar purge purge_ui purge_drush purge_queuer_coretags purge_processor_cron varnish_purger varnish_purge_tags field_group better_exposed_filters"
# Core recipes applied on a fresh install, e.g. page_content_type (Basic page)
# and article_content_type (Article); ignored when installing from config/sync
DRUPAL_RECIPES="page_content_type"

# ----------------------------------------------------------------------------
# PHP CONFIGURATION
# ----------------------------------------------------------------------------
PHP_MEMORY_LIMIT=1024M
PHP_MAX_EXECUTION_TIME=300
PHP_POST_MAX_SIZE=128M
PHP_UPLOAD_MAX_FILESIZE=128M
PHP_DISPLAY_ERRORS=1
PHP_OPCACHE_ENABLE=1
PHP_OPCACHE_MEMORY_CONSUMPTION=256
PHP_OPCACHE_MAX_ACCELERATED_FILES=20000
# re-read changed PHP files (set to 0 in production)
PHP_OPCACHE_VALIDATE_TIMESTAMPS=1
# discard all mail sent by Drupal (nothing leaves the dev environment)
PHP_SENDMAIL_PATH="/bin/true"

# ----------------------------------------------------------------------------
# VARNISH CONFIGURATION
# ----------------------------------------------------------------------------
# where Drupal sends cache invalidations (BAN requests) to
VARNISH_HOST=varnish
VARNISH_PURGE_PORT=80
# shared secret: Varnish only accepts BAN requests with this X-VC-Purge-Key
VARNISH_PURGE_KEY="change_this_varnish_purge_key"

# ----------------------------------------------------------------------------
# MEMCACHE CONFIGURATION
# ----------------------------------------------------------------------------
MEMCACHE_HOST=memcache
MEMCACHE_DISABLE=true
