<?php

/**
 * @file
 * Site features of RedressHub.
 */

declare(strict_types=1);

use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\Core\Site\Settings;
use Drupal\field\FieldStorageConfigInterface;
use Drupal\views\Views;

/**
 * Allowed values of the "View" field of the View paragraph.
 *
 * Lists the block displays of the views tagged "paragraph", so editors can
 * only pick views made for pages.
 *
 * @see callback_allowed_values_function()
 */
function redresshub_site_view_options(FieldStorageConfigInterface $definition, ?FieldableEntityInterface $entity = NULL, bool &$cacheable = TRUE): array {
  $options = [];
  foreach (Views::getEnabledViews() as $view) {
    if (!in_array('paragraph', array_map('trim', explode(',', (string) $view->get('tag'))), TRUE)) {
      continue;
    }
    foreach ($view->get('display') as $display_id => $display) {
      if ($display['display_plugin'] === 'block') {
        $options[$view->id() . ':' . $display_id] = $view->label() . ' – ' . ($display['display_title'] ?? $display_id);
      }
    }
  }
  asort($options);
  return $options;
}

/**
 * Implements hook_theme().
 */
function redresshub_site_theme(): array {
  return [
    'biblio_publication' => [
      'variables' => ['publication' => NULL, 'url' => NULL],
    ],
  ];
}

/**
 * Implements hook_leaflet_map_info().
 *
 * The base map of the explorer; the tiles are a theme setting, their key
 * (MAP_TILES_KEY) a setting of the environment.
 */
function redresshub_site_leaflet_map_info(): array {
  $theme_settings = \Drupal::config('redresshub.settings');
  $tiles = $theme_settings->get('map_tiles') ?: 'https://tile.openstreetmap.org/{z}/{x}/{y}.png';
  if (($key = Settings::get('map_tiles_key')) && !str_contains($tiles, 'key=')) {
    $tiles .= (str_contains($tiles, '?') ? '&' : '?') . 'key=' . rawurlencode($key);
  }
  return [
    'redresshub' => [
      'label' => 'RedressHub',
      'description' => t('The warm base map of the RedressHub explorer.'),
      'settings' => [
        'dragging' => TRUE,
        'touchZoom' => TRUE,
        // Scroll the page, not the map; zoom with the buttons or a pinch.
        'scrollWheelZoom' => FALSE,
        'doubleClickZoom' => TRUE,
        'zoomControl' => TRUE,
        'zoomControlPosition' => 'topleft',
        'attributionControl' => TRUE,
        'trackResize' => TRUE,
        'fadeAnimation' => TRUE,
        'zoomAnimation' => TRUE,
        'closePopupOnClick' => TRUE,
        'minZoom' => 3,
        'maxZoom' => 18,
        'zoom' => 8,
        'layerControl' => FALSE,
      ],
      'layers' => [
        'RedressHub' => [
          'urlTemplate' => $tiles,
          'options' => [
            'attribution' => $theme_settings->get('map_attribution') ?: '&copy; OpenStreetMap',
            'maxZoom' => 18,
          ],
        ],
      ],
      'plugins' => [],
    ],
  ];
}

/**
 * Implements hook_views_data_alter().
 */
function redresshub_site_views_data_alter(array &$data): void {
  // The site index: Views cannot tell that these index fields hold term or
  // node IDs, so give their filters a select list.
  if (isset($data['search_api_index_all_content'])) {
    $index = &$data['search_api_index_all_content'];
    foreach (['redresshub_initiative_types_i', 'redresshub_initiative_keywords_i', 'field_organisations_sector_i'] as $field) {
      if (isset($index[$field]['filter'])) {
        $index[$field]['filter']['id'] = 'search_api_term';
      }
    }
    if (isset($index['field_organisations_i']['filter'])) {
      $index['field_organisations_i']['filter']['id'] = 'search_api_options';
      $index['field_organisations_i']['filter']['options callback'] = '_redresshub_site_organisation_options';
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for views_exposed_form.
 *
 * Keeps the chosen view of the explorer (?view=…) when filtering.
 */
function redresshub_site_form_views_exposed_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  $view = $form_state->get('view');
  if ($view && str_starts_with($view->id(), 'explorer_')) {
    $current = \Drupal::request()->query->get('view');
    if (is_string($current) && $current !== '') {
      $form['view'] = ['#type' => 'hidden', '#value' => $current, '#name' => 'view'];
    }
    $form['#attributes']['class'][] = 'explorer__form';
    // The explorer is on the front page; filter there (not on /node/…).
    $form['#action'] = \Drupal\Core\Url::fromRoute('<front>')->toString();
  }
}

/**
 * Implements hook_field_widget_single_element_form_alter().
 *
 * Text + media paragraph: the Slideshow switch shows either the media field
 * or the images field, and the chosen one must be filled in.
 */
function redresshub_site_field_widget_single_element_form_alter(array &$element, \Drupal\Core\Form\FormStateInterface $form_state, array $context): void {
  if (($element['#paragraph_type'] ?? NULL) !== 'text_media' || !isset($element['subform']['field_slideshow'], $element['subform']['#parents'])) {
    return;
  }
  $parents = $element['subform']['#parents'];
  $name = array_shift($parents) . ($parents ? '[' . implode('][', $parents) . ']' : '') . '[field_slideshow][value]';
  $selector = ':input[name="' . $name . '"]';
  $element['subform']['field_media']['#states']['visible'][$selector] = ['checked' => FALSE];
  $element['subform']['field_media_multiple']['#states']['visible'][$selector] = ['checked' => TRUE];
  $element['subform']['#element_validate'][] = '_redresshub_site_text_media_validate';
}

/**
 * Element validation: a Text + media paragraph needs its media or images.
 */
function _redresshub_site_text_media_validate(array $element, \Drupal\Core\Form\FormStateInterface $form_state): void {
  // Buttons that limit validation (media library, remove) ignore this error.
  $values = $form_state->getValue($element['#parents']) ?? [];
  $slideshow = !empty($values['field_slideshow']['value']);
  $field = $slideshow ? 'field_media_multiple' : 'field_media';
  $selection = $values[$field]['selection'] ?? [];
  if (!array_filter(array_column((array) $selection, 'target_id')) && isset($element[$field])) {
    $form_state->setError($element[$field], $slideshow
      ? t('Choose the images of the slideshow.')
      : t('Choose an image, video or audio fragment.'));
  }
}

/**
 * Implements hook_rabbit_hole_values_alter().
 *
 * Content without a page of its own (research data, terms) has none for the
 * administrator either: the edit form, like for the other editors.
 */
function redresshub_site_rabbit_hole_values_alter(array &$values, \Drupal\Core\Entity\ContentEntityInterface $entity): void {
  if (($values['rh_action'] ?? NULL) === 'redresshub_edit_form_or_not_found') {
    $values['bypass_access'] = FALSE;
  }
}

/**
 * Implements hook_ENTITY_TYPE_build_defaults_alter() for node.
 *
 * The Home node shows the explorer, which depends on the URL (?view=…, the
 * filters).
 */
function redresshub_site_node_build_defaults_alter(array &$build, \Drupal\Core\Entity\EntityInterface $node, string $view_mode): void {
  if ($node->bundle() === 'home') {
    $build['#cache']['contexts'][] = 'url.query_args';
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert() for node.
 */
function redresshub_site_node_insert(\Drupal\node\NodeInterface $node): void {
  _redresshub_site_reindex_organisations($node);
}

/**
 * Implements hook_ENTITY_TYPE_update() for node.
 */
function redresshub_site_node_update(\Drupal\node\NodeInterface $node): void {
  _redresshub_site_reindex_organisations($node);
}

/**
 * Implements hook_ENTITY_TYPE_delete() for node.
 */
function redresshub_site_node_delete(\Drupal\node\NodeInterface $node): void {
  _redresshub_site_reindex_organisations($node);
}

/**
 * Marks the organisations of an initiative for indexing.
 *
 * The site index has the types and keywords of the initiatives of an
 * organisation (see ExplorerFields), so they change with the initiative.
 */
function _redresshub_site_reindex_organisations(\Drupal\node\NodeInterface $node): void {
  if ($node->bundle() !== 'initiative' || !\Drupal::moduleHandler()->moduleExists('search_api')) {
    return;
  }
  $ids = array_column($node->get('field_organisations')->getValue(), 'target_id');
  if (isset($node->original)) {
    $ids = array_merge($ids, array_column($node->original->get('field_organisations')->getValue(), 'target_id'));
  }
  $index = \Drupal\search_api\Entity\Index::load('all_content');
  if (!$ids || !$index) {
    return;
  }
  $items = [];
  foreach (\Drupal\node\Entity\Node::loadMultiple(array_unique($ids)) as $organisation) {
    foreach (\Drupal::languageManager()->getLanguages() as $langcode => $language) {
      $items[] = $organisation->id() . ':' . $langcode;
    }
  }
  $index->trackItemsUpdated('entity:node', $items);
}

/**
 * Returns the published organisations: nid => title, for filters.
 */
function _redresshub_site_organisation_options(): array {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $ids = $storage->getQuery()->accessCheck(TRUE)
    ->condition('type', 'organisation')->condition('status', 1)->sort('title')->execute();
  return array_map(fn($node) => $node->label(), $storage->loadMultiple($ids));
}
