<?php

/**
 * @file
 * Preprocess functions for the RedressHub theme.
 */

declare(strict_types=1);

use Drupal\Component\Utility\Html;
use Drupal\Core\Entity\ContentEntityInterface;
use Drupal\Core\Language\LanguageInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Url;
use Drupal\node\Entity\Node;
use Drupal\node\NodeInterface;
use Drupal\taxonomy\TermInterface;

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 *
 * Adds classes for the layout of the page:
 * - "page--<alias>", e.g. page--contact.
 * - "page-title--center" when a basic page has a centered title.
 * - "page--wide" on basic pages: the wide layout of About.
 * - "page--has-tabs" when a basic page has tabs.
 */
function redresshub_preprocess_html(array &$variables): void {
  $current_path = \Drupal::service('path.current')->getPath();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);
  $slug = trim($alias, '/');
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $slug = 'front';
  }
  if ($slug !== '' && !str_contains($slug, '/')) {
    $variables['attributes']['class'][] = 'page--' . Html::getClass($slug);
  }

  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof NodeInterface && in_array($node->bundle(), ['page', 'example'], TRUE) && \Drupal::routeMatch()->getRouteName() === 'entity.node.canonical') {
    if ($node->get('field_title_alignment')->value === 'center') {
      $variables['attributes']['class'][] = 'page-title--center';
    }
    if ($node->hasField('field_tabs') && !$node->get('field_tabs')->isEmpty()) {
      $variables['attributes']['class'][] = 'page--has-tabs';
    }
    // Basic pages line up with About: the wide layout, with space on the left.
    $variables['attributes']['class'][] = 'page--wide';
  }
}

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 */
function redresshub_preprocess_page(array &$variables): void {
  $variables['site_name'] = \Drupal::config('system.site')->get('name');
  $variables['contact_email'] = theme_get_setting('contact_email');
  $variables['footer_logos'] = _redresshub_footer_logos();
  // Printed in the footer, so a new or changed logo shows on cached pages.
  $variables['footer_logos_cache'] = ['#cache' => ['tags' => ['media_list:partner_logo']]];

  if ($variables['is_front']) {
    $variables['#attached']['library'][] = 'redresshub/front';
  }
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof NodeInterface) {
    $variables['#attached']['library'][] = 'redresshub/pages';
  }
  $variables['#cache']['tags'][] = 'config:redresshub.settings';
  $variables['#cache']['tags'][] = 'config:system.site';
}

/**
 * Implements hook_preprocess_HOOK() for paragraph.html.twig.
 */
function redresshub_preprocess_paragraph(array &$variables): void {
  /** @var \Drupal\paragraphs\ParagraphInterface $paragraph */
  $paragraph = $variables['paragraph'];

  $variables['icon_url'] = _redresshub_icon_url($paragraph);

  // Anchor for links like /about#user-manual, from the English title so it
  // is the same in every language (of a tab: its administrative title).
  foreach (['field_title', 'paragroup_admin_title'] as $title_field) {
    if ($paragraph->hasField($title_field) && ($title = $paragraph->getUntranslated()->get($title_field)->value)) {
      $variables['attributes']['id'] = trim(preg_replace('/[^a-z0-9]+/', '-', mb_strtolower($title)), '-');
      break;
    }
  }
  foreach (['field_alignment' => 'alignment', 'field_button_style' => 'button_style', 'field_background' => 'background'] as $field => $variable) {
    if ($paragraph->hasField($field)) {
      $variables[$variable] = $paragraph->get($field)->value;
    }
  }

  if ($paragraph->hasField('field_button') && !$paragraph->get('field_button')->isEmpty()) {
    $link = $paragraph->get('field_button')->first();
    $variables['button_url'] = $link->getUrl()->toString();
    $variables['button_title'] = $link->title ?: $variables['button_url'];
  }
  if ($paragraph->hasField('field_link') && !$paragraph->get('field_link')->isEmpty()) {
    $variables['link_url'] = $paragraph->get('field_link')->first()->getUrl()->toString();
  }

  // Text + media paragraph: the images of the slideshow (when it is on), and
  // the caption unless it is hidden.
  if ($paragraph->bundle() === 'text_media') {
    $variables['slides'] = [];
    if ($paragraph->get('field_slideshow')->value && isset($variables['content']['field_media_multiple'])) {
      foreach (Element::children($variables['content']['field_media_multiple']) as $delta) {
        $variables['slides'][] = $variables['content']['field_media_multiple'][$delta];
      }
    }
    $show = $paragraph->get('field_show_caption');
    $variables['caption'] = ($show->isEmpty() || $show->value) ? $paragraph->get('field_caption')->value : '';
    // The first block of a page is its header: it shows the page title.
    $parent = $paragraph->getParentEntity();
    if ($parent instanceof NodeInterface && _redresshub_page_header($parent)?->id() === $paragraph->id()) {
      // The page in the language it is shown in (the block may have no
      // translation of its own).
      $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
      $parent = $parent->hasTranslation($langcode) ? $parent->getTranslation($langcode) : $parent;
      $variables['page_title'] = $parent->label();
      $variables['pretitle'] = $parent->get('field_pretitle')->value;
    }
  }

  // View paragraph: render the chosen view ("view_id:display_id").
  if ($paragraph->bundle() === 'view' && ($value = $paragraph->get('field_view')->value)) {
    [$view_id, $display_id] = explode(':', $value, 2) + [1 => 'default'];
    $variables['view'] = views_embed_view($view_id, $display_id);
  }
}

/**
 * Implements hook_preprocess_HOOK() for node.html.twig.
 */
function redresshub_preprocess_node(array &$variables): void {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $variables['node'];

  if ($node->bundle() === 'fragment') {
    $term = $node->get('field_fragment_type')->entity;
    $variables['fragment_type'] = $term instanceof TermInterface
      ? strtolower($term->getUntranslated()->label())
      : 'text';
    // A fragment with page content: the tile links to that page.
    $variables['page_url'] = !$node->get('field_content')->isEmpty() ? $variables['url'] : NULL;
  }

  if ($node->bundle() === 'home' && $variables['view_mode'] === 'full') {
    $image = $node->get('field_hero_image')->entity?->get('field_media_image')->entity;
    $variables['hero_image_url'] = $image
      ? \Drupal::service('file_url_generator')->generateString($image->getFileUri())
      : '/' . \Drupal::service('extension.list.theme')->getPath('redresshub') . '/images/hero.jpg';
    $variables['explorer'] = _redresshub_explorer();
    $variables['#attached']['library'][] = 'redresshub/explorer';
  }

  if (in_array($variables['view_mode'], ['panel', 'tile'], TRUE) && in_array($node->bundle(), ['initiative', 'organisation'], TRUE)) {
    _redresshub_preprocess_explorer_item($variables);
  }

  if ($node->bundle() === 'event') {
    $date = $node->get('field_event_date')->first();
    if ($date && $date->start_date) {
      $formatter = \Drupal::service('date.formatter');
      $format = 'F j, Y';
      $start = $formatter->format($date->start_date->getTimestamp(), 'custom', $format);
      $end = $date->end_date ? $formatter->format($date->end_date->getTimestamp(), 'custom', $format) : NULL;
      $variables['event_date'] = $end && $end !== $start ? "$start – $end" : $start;
    }
    if (!$node->get('field_link')->isEmpty()) {
      $link = $node->get('field_link')->first();
      $variables['link_url'] = $link->getUrl()->toString();
      $variables['link_title'] = $link->title;
    }
  }
}

/**
 * Returns the URL of the SVG of the icon chosen in an entity, if any.
 */
function _redresshub_icon_url(ContentEntityInterface $entity): ?string {
  if (!$entity->hasField('field_icon') || !($term = $entity->get('field_icon')->entity)) {
    return NULL;
  }
  $file = $term->get('field_svg')->entity;
  return $file ? \Drupal::service('file_url_generator')->generateString($file->getFileUri()) : NULL;
}

/**
 * The views of the explorer: key => [view, display, kind].
 */
const REDRESSHUB_EXPLORER_VIEWS = [
  'map-initiatives' => ['explorer_initiatives', 'map', 'initiatives'],
  'map-organisations' => ['explorer_organisations', 'map', 'organisations'],
  'list-initiatives' => ['explorer_initiatives', 'list', 'initiatives'],
  'list-organisations' => ['explorer_organisations', 'list', 'organisations'],
  'network' => ['explorer_network', 'list', 'network'],
];

/**
 * The filters (URL parameters) of each kind of view.
 */
const REDRESSHUB_EXPLORER_FILTERS = [
  'initiatives' => ['search', 'type', 'org', 'keyword', 'sector', 'period'],
  'organisations' => ['search', 'sector', 'status', 'type', 'keyword', 'period'],
  'network' => ['keyword', 'period'],
];

/**
 * Returns the variables of the explorer on the Home node.
 *
 * The view is chosen with ?view=…; the toolbar links keep the filters that
 * the other view also has.
 */
function _redresshub_explorer(): array {
  $query = \Drupal::request()->query->all();
  $current = isset($query['view'], REDRESSHUB_EXPLORER_VIEWS[$query['view']]) ? $query['view'] : 'map-initiatives';
  [$view_id, $display_id, $kind] = REDRESSHUB_EXPLORER_VIEWS[$current];

  $links = [];
  foreach (REDRESSHUB_EXPLORER_VIEWS as $key => [, , $target_kind]) {
    $params = array_filter(
      array_intersect_key($query, array_flip(REDRESSHUB_EXPLORER_FILTERS[$target_kind])),
      '_redresshub_explorer_filter_is_set',
    );
    if ($key !== 'map-initiatives') {
      $params = ['view' => $key] + $params;
    }
    $links[$key] = Url::fromRoute('<front>', [], ['query' => $params])->toString();
  }

  // What the filter panel holds: on the map and the network the period is
  // on the stage, so it does not count there.
  $panel_filters = REDRESSHUB_EXPLORER_FILTERS[$kind];
  if ($display_id === 'map' || $kind === 'network') {
    $panel_filters = array_diff($panel_filters, ['period']);
  }
  $active = array_filter(
    array_intersect_key($query, array_flip($panel_filters)),
    '_redresshub_explorer_filter_is_set',
  );

  // The date of the last change to an initiative or organisation.
  $nids = \Drupal::entityQuery('node')->accessCheck(TRUE)
    ->condition('type', ['initiative', 'organisation'], 'IN')
    ->sort('changed', 'DESC')->range(0, 1)->execute();
  $last = $nids ? Node::load(reset($nids)) : NULL;

  return [
    'current' => $current,
    'kind' => $kind,
    'links' => $links,
    'active_filters' => count($active),
    'view' => views_embed_view($view_id, $display_id),
    'updated' => $last ? \Drupal::service('date.formatter')->format($last->getChangedTime(), 'custom', 'F j, Y') : NULL,
  ];
}

/**
 * Whether a filter value in the URL is set (period is [from, to]).
 */
function _redresshub_explorer_filter_is_set(mixed $value): bool {
  if (is_array($value)) {
    return (bool) array_filter($value, '_redresshub_explorer_filter_is_set');
  }
  return is_string($value) && $value !== '' && $value !== 'All';
}

/**
 * Prepares an initiative or organisation for the side panel or a tile.
 *
 * Sets facts (label => items, each with text and an optional URL or, for
 * linked research data, the node ID: it has no page of its own and opens in
 * the panel), text, resources and, for tiles, a short meta line and the
 * rendered panel.
 */
function _redresshub_preprocess_explorer_item(array &$variables): void {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $variables['node'];
  $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
  $translate = fn($entity) => $entity && $entity->hasTranslation($langcode) ? $entity->getTranslation($langcode) : $entity;
  $node = $translate($node);

  $labels = fn(string $field) => array_map(
    fn($entity) => ['text' => $translate($entity)->label()],
    $node->get($field)->referencedEntities(),
  );
  $links = fn(array $entities) => array_map(
    fn($entity) => ['text' => $translate($entity)->label(), 'nid' => $entity->id()],
    $entities,
  );

  $period = $node->get('field_period')->first();
  $start = $period?->value ? substr($period->value, 0, 4) : NULL;
  $end = $period?->end_value ? substr($period->end_value, 0, 4) : NULL;
  $period_text = $start ? ($end ? ($end === $start ? $start : "$start – $end") : t('@year – ongoing', ['@year' => $start])) : NULL;

  $facts = [];
  if ($node->bundle() === 'initiative') {
    if ($period_text && !$node->get('field_period_certain')->value) {
      $period_text .= ' (' . t('uncertain') . ')';
    }
    $facts[(string) t('Period')] = $period_text ? [['text' => $period_text]] : [];
    $facts[(string) t('Type of initiative')] = $labels('field_initiative_type');
    $facts[(string) t('UN category')] = $labels('field_un_category');
    $facts[(string) t('Organisation(s)')] = $links($node->get('field_organisations')->referencedEntities());
    $facts[(string) t('Location')] = $labels('field_place');
    $facts[(string) t('Keywords')] = $labels('field_keywords');
    $variables['text'] = $node->get('field_short_description')->processed;
    $variables['resources'] = array_map(fn($item) => $item->getUrl()->toString(), iterator_to_array($node->get('field_resources')));
    $meta = array_filter([implode(', ', array_column($labels('field_initiative_type'), 'text')), $start ? ($end ? ($end === $start ? $start : "{$start}–{$end}") : "{$start}–") : '']);
  }
  else {
    $initiative_ids = \Drupal::entityQuery('node')->accessCheck(TRUE)
      ->condition('type', 'initiative')->condition('status', 1)
      ->condition('field_organisations', $node->id())->sort('title')->execute();
    $facts[(string) t('Sector')] = $labels('field_sector');
    $facts[(string) t('Status')] = $labels('field_organisation_status');
    $facts[(string) t('Period')] = $period_text ? [['text' => $period_text]] : [];
    $facts[(string) t('Location')] = $labels('field_locations');
    $facts[(string) t('Initiatives')] = $links(Node::loadMultiple($initiative_ids));
    $website = $node->get('field_website')->first();
    $facts[(string) t('Website')] = $website ? [['text' => preg_replace('#^https?://(www\.)?#', '', rtrim($website->getUrl()->toString(), '/')), 'url' => $website->getUrl()->toString()]] : [];
    $meta = [implode(', ', array_column($labels('field_sector'), 'text'))];
  }
  // Term labels are shown as tags.
  $variables['tag_facts'] = [(string) t('Type of initiative'), (string) t('UN category'), (string) t('Keywords'), (string) t('Sector'), (string) t('Status')];
  $variables['facts'] = array_filter($facts);
  $variables['kicker'] = $node->bundle() === 'initiative' ? t('Initiative') : t('Organisation');
  $variables['meta'] = implode(' · ', array_filter($meta));

  if ($variables['view_mode'] === 'tile') {
    $variables['panel'] = \Drupal::entityTypeManager()->getViewBuilder('node')->view($node, 'panel');
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for views_view.
 *
 * One template for the explorer views: views-view--explorer.html.twig.
 */
function redresshub_theme_suggestions_views_view_alter(array &$suggestions, array $variables): void {
  if (str_starts_with($variables['view']->id(), 'explorer_')) {
    $suggestions[] = 'views_view__explorer';
  }
}

/**
 * Implements hook_preprocess_HOOK() for views_view.
 *
 * The explorer views are embedded, not placed as blocks, so Views gives them
 * no "Edit view" link: the explorer adds it, to the display that is shown.
 */
function redresshub_preprocess_views_view(array &$variables): void {
  $view = $variables['view'];
  $account = \Drupal::currentUser();
  if (!str_starts_with($view->id(), 'explorer_') || !\Drupal::moduleHandler()->moduleExists('views_ui')
    || !$account->hasPermission('access contextual links') || !$account->hasPermission('administer views')) {
    return;
  }
  $links = [
    'entity.view.edit_form' => [
      'route_parameters' => ['view' => $view->id()],
      'metadata' => ['location' => 'view', 'name' => $view->id(), 'display_id' => $view->current_display],
    ],
  ];
  $variables['title_suffix']['contextual_links'] = [
    '#type' => 'contextual_links_placeholder',
    '#id' => _contextual_links_to_id($links),
  ];
  $variables['attributes']['class'][] = 'contextual-region';
}

/**
 * Implements hook_preprocess_HOOK() for links__language_block.
 *
 * The current language, for the button of the language switcher.
 */
function redresshub_preprocess_links__language_block(array &$variables): void {
  $variables['current_langcode'] = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_INTERFACE)->getId();
  $variables['#cache']['contexts'][] = 'languages:language_interface';
}

/**
 * Returns the header of a page: its first block, when that is Text + media.
 *
 * The header shows the pretitle and the title of the page next to its media,
 * in place of the title above the page (see
 * redresshub_preprocess_page_title()).
 */
function _redresshub_page_header(NodeInterface $node): ?\Drupal\paragraphs\ParagraphInterface {
  if (!in_array($node->bundle(), ['page', 'example'], TRUE) || !$node->hasField('field_content')) {
    return NULL;
  }
  $first = $node->get('field_content')->first()?->entity;
  return $first && $first->bundle() === 'text_media' ? $first : NULL;
}

/**
 * Implements hook_preprocess_HOOK() for page-title.html.twig.
 *
 * A page with a header (a first Text + media block) shows its title there;
 * otherwise the pretitle of the page goes above its title.
 */
function redresshub_preprocess_page_title(array &$variables): void {
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof NodeInterface && \Drupal::routeMatch()->getRouteName() === 'entity.node.canonical') {
    if (_redresshub_page_header($node)) {
      $variables['title'] = NULL;
    }
    elseif ($node->hasField('field_pretitle')) {
      $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
      $node = $node->hasTranslation($langcode) ? $node->getTranslation($langcode) : $node;
      $variables['pretitle'] = $node->get('field_pretitle')->value;
    }
  }
  $variables['#cache']['contexts'][] = 'route';
}

/**
 * Returns the partner logos of the footer (Partner logo media), in order.
 *
 * @return array
 *   Items with url, alt, link and name; their cache tag is in
 *   footer_logos_cache (see redresshub_preprocess_page()).
 */
function _redresshub_footer_logos(): array {
  $storage = \Drupal::entityTypeManager()->getStorage('media');
  $ids = $storage->getQuery()->accessCheck(TRUE)
    ->condition('bundle', 'partner_logo')->condition('status', 1)
    ->sort('field_weight')->sort('name')->execute();
  $logos = [];
  foreach ($storage->loadMultiple($ids) as $media) {
    $image = $media->get('field_media_image')->first();
    if (!$image?->entity) {
      continue;
    }
    $link = $media->get('field_link')->first();
    $logos[] = [
      'url' => \Drupal::service('file_url_generator')->generateString($image->entity->getFileUri()),
      'alt' => $image->alt ?: $media->label(),
      'link' => $link ? $link->getUrl()->toString() : NULL,
      'name' => $media->label(),
    ];
  }
  return $logos;
}
