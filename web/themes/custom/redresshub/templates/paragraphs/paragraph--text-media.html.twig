{#
/**
 * @file
 * Text + media paragraph: text with an image, video or audio fragment, or a
 * slideshow of images, next to it. The layout says on which side the media
 * is and how wide it is (half or a third); on narrow screens the media is
 * below the text.
 *
 * The caption is a label on the media; the image zooms in a little on hover.
 * The first block of a page is its header: it shows the pretitle and the
 * title (h1) of the page in place of its own title.
 *
 * Variables from redresshub_preprocess_paragraph(): slides (the rendered
 * images of the slideshow), caption (empty when hidden), page_title and
 * pretitle (in the header of a page).
 */
#}
{% set layout = paragraph.field_media_layout.value ?: 'right_50' %}
{% set label %}
  {% if caption %}<figcaption class="text-media__caption">{{ caption }}</figcaption>{% endif %}
{% endset %}
<section{{ attributes.addClass('paragraph', 'text-media', 'text-media--' ~ layout|clean_class, page_title ? 'text-media--page-header') }}>
  <figure class="text-media__media">
    {% if slides|length > 1 %}
      {{ attach_library('redresshub/slideshow') }}
      <div class="slideshow" aria-roledescription="{{ 'slideshow'|t }}">
        <div class="text-media__frame">
          <div class="slideshow__track" tabindex="0">
            {% for slide in slides %}
              <div class="slideshow__slide" aria-roledescription="{{ 'slide'|t }}" aria-label="{{ loop.index }} / {{ slides|length }}">{{ slide }}</div>
            {% endfor %}
          </div>
          {{ label }}
        </div>
        <div class="slideshow__controls" hidden>
          <button type="button" class="slideshow__button slideshow__button--prev" aria-label="{{ 'Previous image'|t }}"><span class="icon icon--chevron-down" aria-hidden="true"></span></button>
          <span class="slideshow__count" aria-live="polite">1 / {{ slides|length }}</span>
          <button type="button" class="slideshow__button slideshow__button--next" aria-label="{{ 'Next image'|t }}"><span class="icon icon--chevron-down" aria-hidden="true"></span></button>
        </div>
      </div>
    {% else %}
      <div class="text-media__frame">
        {{ slides ? slides|first : content.field_media }}
        {{ label }}
      </div>
    {% endif %}
  </figure>
  <div class="text-media__body">
    {% if page_title %}
      {% if pretitle %}
        <p class="pretitle">{{ pretitle }}</p>
      {% endif %}
      <h1 class="page-title text-media__page-title">{{ page_title }}</h1>
    {% elseif paragraph.field_title.value %}
      <h2 class="text-block__title">{{ paragraph.field_title.value }}</h2>
    {% endif %}
    {% if content.field_text|render|trim %}
      <div class="text-media__text prose">{{ content.field_text }}</div>
    {% endif %}
  </div>
</section>
