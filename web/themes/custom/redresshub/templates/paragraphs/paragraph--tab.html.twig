{#
/**
 * @file
 * A tab: js/tabs.js turns the panels into tabs.
 */
#}
{# The title of the tab is Paragraph Group's administrative title. #}
<section{{ attributes.addClass('content-tabs__panel').setAttribute('data-tab-label', paragraph.paragroup_admin_title.value) }}>
  <h2 class="visually-hidden">{{ paragraph.paragroup_admin_title.value }}</h2>
  {{ content.field_content }}
</section>
