{#
/**
 * @file
 * The explorer: a toolbar to switch between the views, and the chosen view
 * (views-view--explorer.html.twig) with its filters.
 *
 * Variables: current, kind, links, active_filters, view, updated.
 */
#}
<div class="explorer" data-explorer data-view="{{ current }}">
  <div class="explorer__bar">
    <button type="button" class="explorer__bar-button explorer__filter-toggle" aria-expanded="false" aria-controls="explorer-filters">
      <span class="icon icon--sliders-horizontal" aria-hidden="true"></span>
      <span class="explorer__filter-label">{{ 'Filter the map'|t }}</span>
      {% if active_filters %}<span class="explorer__count">{{ active_filters }}</span>{% endif %}
      <span class="icon icon--chevron-down explorer__chevron" aria-hidden="true"></span>
    </button>
    <div class="explorer__menu{{ current starts with 'map' ? ' is-active' }}">
      <button type="button" class="explorer__bar-button" aria-haspopup="true" aria-expanded="false">
        <span class="icon icon--map" aria-hidden="true"></span>{{ 'Map view'|t }}
        <span class="icon icon--chevron-down" aria-hidden="true"></span>
      </button>
      <ul class="explorer__menu-list" hidden>
        <li><a href="{{ links['map-initiatives'] }}"{{ current == 'map-initiatives' ? ' class="is-active" aria-current="true"' }}>{{ 'Initiative-centred'|t }}</a></li>
        <li><a href="{{ links['map-organisations'] }}"{{ current == 'map-organisations' ? ' class="is-active" aria-current="true"' }}>{{ 'Organisation-centred'|t }}</a></li>
      </ul>
    </div>
    <div class="explorer__menu{{ current starts with 'list' ? ' is-active' }}">
      <button type="button" class="explorer__bar-button" aria-haspopup="true" aria-expanded="false">
        <span class="icon icon--list" aria-hidden="true"></span>{{ 'List view'|t }}
        <span class="icon icon--chevron-down" aria-hidden="true"></span>
      </button>
      <ul class="explorer__menu-list" hidden>
        <li><a href="{{ links['list-initiatives'] }}"{{ current == 'list-initiatives' ? ' class="is-active" aria-current="true"' }}>{{ 'Initiatives'|t }}</a></li>
        <li><a href="{{ links['list-organisations'] }}"{{ current == 'list-organisations' ? ' class="is-active" aria-current="true"' }}>{{ 'Organisations'|t }}</a></li>
      </ul>
    </div>
    <a class="explorer__bar-button{{ current == 'network' ? ' is-active' }}" href="{{ links['network'] }}"{{ current == 'network' ? ' aria-current="true"' }}>
      <span class="icon icon--network" aria-hidden="true"></span>{{ 'Network'|t }}
    </a>
  </div>

  {{ view }}

  {% if updated %}
    <p class="map-layout__note explorer__updated">{{ 'Map data last updated @date.'|t({'@date': updated}) }}</p>
  {% endif %}
</div>
