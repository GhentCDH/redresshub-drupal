{#
/**
 * @file
 * Theme override for page titles, with the pretitle of a page above them
 * (from redresshub_preprocess_page_title()).
 */
#}
{{ title_prefix }}
{% if title and pretitle %}
  <p class="pretitle page-pretitle">{{ pretitle }}</p>
{% endif %}
{% if title %}
  <h1{{ title_attributes.addClass('page-title') }}>{{ title }}</h1>
{% endif %}
{{ title_suffix }}
