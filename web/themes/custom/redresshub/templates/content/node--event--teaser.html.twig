{#
/**
 * @file
 * An event in the Moments ahead timeline.
 */
#}
<article{{ attributes.addClass('event') }}>
  <p class="event__date has-icon icon--calendar">{{ event_date }}</p>
  <h3 class="event__title">{{ label }}</h3>
  {% if node.field_short_description.value %}
    <div class="event__text">{{ content.field_short_description }}</div>
  {% endif %}
  {% if node.field_event_location.value %}
    <p class="event__location has-icon icon--map-pin">{{ node.field_event_location.value }}</p>
  {% endif %}
  {% if link_url %}
    <a class="event__link has-icon-after icon--external-link" href="{{ link_url }}">{{ link_title ?: 'Learn more'|t }}</a>
  {% endif %}
</article>
