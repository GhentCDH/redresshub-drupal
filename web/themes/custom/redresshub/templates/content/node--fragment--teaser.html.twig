{#
/**
 * @file
 * A fragment in the Uncharted masonry, styled by its type.
 *
 * fragment_type: text, quote, image, audio or video; page_url: the page of
 * the fragment, when it has page content. From redresshub_preprocess_node().
 */
#}
{% set more %}
  {% if page_url %}
    <a class="tile-more" href="{{ page_url }}">{{ 'Read more'|t }}<span class="visually-hidden">: {{ label }}</span></a>
  {% endif %}
{% endset %}
{% if fragment_type in ['image', 'video'] %}
  <figure{{ attributes.addClass('tile-photo') }}>
    {{ content.field_media }}
    {% if node.field_caption.value or page_url %}
      <figcaption>{{ node.field_caption.value }}{{ more }}</figcaption>
    {% endif %}
  </figure>
{% elseif fragment_type == 'quote' %}
  <div{{ attributes.addClass('tile-reflection') }}>
    <blockquote>{{ content.field_text }}</blockquote>
    {{ more }}
  </div>
{% elseif fragment_type == 'audio' %}
  <div{{ attributes.addClass('tile-audio') }}>
    <h3 style="--icon: url('{{ '/' ~ directory }}/images/icons/volume-2.svg');"><span class="icon" aria-hidden="true"></span>{{ label }}</h3>
    {{ content.field_text }}
    {% if not node.field_media.isEmpty() %}
      {{ content.field_media }}
    {% else %}
      <p class="placeholder-box">{{ 'Audio player'|t }}</p>
    {% endif %}
    {{ more }}
  </div>
{% else %}
  <div{{ attributes.addClass('tile-text') }}>
    {{ content.field_text }}
    {{ more }}
  </div>
{% endif %}
