{#
/**
 * @file
 * Front page: the Home node (node--home.html.twig) over the full width.
 */
#}
<div class="layout-container">
  {% include '@redresshub/layout/_header.html.twig' %}

  <main class="site-main" role="main">
    <a id="main-content" tabindex="-1"></a>{# link is in html.html.twig #}
    {% set admin = page.highlighted|render ~ page.help|render ~ page.content.redresshub_local_tasks|render %}
    {% if admin|striptags|trim %}
      <div class="container front-admin">{{ admin }}</div>
    {% endif %}
    {{ page.content|without('redresshub_page_title', 'redresshub_local_tasks') }}
  </main>

  {% include '@redresshub/layout/_footer.html.twig' %}
</div>
