{#
/**
 * @file
 * Three column site footer, with the partner logos (Partner logo media,
 * managed by the editors) below it. Included by the page templates.
 */
#}
<footer class="site-footer" role="contentinfo">
  <div class="site-footer__inner container">
    <div class="site-footer__col">
      <div class="site-footer__name">{{ site_name }}</div>
      <div class="site-footer__credits">
        <div>{{ 'ERC Proof of Concept project'|t }}</div>
        <div>{{ 'Justice Visions'|t }}</div>
      </div>
    </div>
    <div class="site-footer__col">
      {{ page.footer }}
    </div>
    <div class="site-footer__col">
      {% if contact_email %}
        <a href="mailto:{{ contact_email }}">{{ contact_email }}</a>
      {% endif %}
    </div>
  </div>
  {{ footer_logos_cache }}
  {% if footer_logos %}
    <div class="site-footer__logos container">
      <ul class="site-footer__logo-list">
        {% for logo in footer_logos %}
          <li class="site-footer__logo">
            {% if logo.link %}
              <a href="{{ logo.link }}" rel="noopener" target="_blank"><img src="{{ logo.url }}" alt="{{ logo.alt }}" loading="lazy"></a>
            {% else %}
              <img src="{{ logo.url }}" alt="{{ logo.alt }}" loading="lazy">
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}
</footer>
